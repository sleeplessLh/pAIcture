{
  "manifest_version": 3,
  "name": "pAIcture Companion",
  "version": "0.3.0",
  "description": "Imports a selected ChatGPT conversation from your signed-in browser into pAIcture.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Export this conversation with pAIcture" },
  "content_scripts": [
    {
      "matches": [
        "https://paicture.lawrancehii12345.chatgpt.site/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
