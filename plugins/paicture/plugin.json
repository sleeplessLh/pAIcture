{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "paicture",
  "version": "0.1.0",
  "description": "Turn the current AI conversation into a polished PDF or paginated PNG images.",
  "author": { "name": "pAIcture" },
  "homepage": "https://paicture-plugin.lawrancehii12345.chatgpt.site",
  "repository": "https://github.com/sleeplessLh/pAIcture",
  "license": "MIT",
  "keywords": ["chatgpt", "pdf", "conversation", "export"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "pAIcture",
        "shortDescription": "Export chats to PDF or PNG",
        "longDescription": "Prepare the current ChatGPT conversation as a faithful document preview, then save it as an A4 PDF or paginated high-resolution PNG images.",
        "developerName": "pAIcture",
        "category": "Productivity",
        "capabilities": ["Format conversations", "Export PDF", "Export PNG"],
        "websiteURL": "https://paicture-plugin.lawrancehii12345.chatgpt.site",
        "supportURL": "https://paicture-plugin.lawrancehii12345.chatgpt.site/support",
        "privacyPolicyURL": "https://paicture-plugin.lawrancehii12345.chatgpt.site/privacy",
        "termsOfServiceURL": "https://paicture-plugin.lawrancehii12345.chatgpt.site/terms",
        "defaultPrompt": ["Export this conversation with pAIcture.", "Create a PDF preview of this chat.", "Turn this conversation into PNG pages."],
        "brandColor": "#C43D1B",
        "brandColorDark": "#FF9275",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/logo.svg"
      }
    }
  }
}
